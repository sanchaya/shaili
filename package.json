        "@adminjs/sequelize": "^4.0.0",
        "@react-oauth/google": "^0.12.1",
        "@types/puppeteer": "^7.0.4",
        "@types/react": "^18.2.25",
        "@types/react-redux": "^7.1.27",
        "@types/react-router": "^5.1.20",
        "@types/sequelize": "^4.28.15",
        "adminjs": "^7.2.1",
        "archiver": "^6.0.1",
