{
    "name": "type-extract",
    "version": "0.0.1",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "ts-node dist/index.js",
        "build": "pnpm clean && tsc && pnpm copy-files && pnpm copy-env",
        "clean": "mkdir -p ./dist && mkdir -p ./dist/public && find ./dist -mindepth 1 -maxdepth 1 ! -name 'public' -exec rm -rf {} \\; && find ./dist/public -mindepth 1 -maxdepth 1 ! -name 'tags' -exec rm -rf {} \\;",
        "copy-files": "cp -r ./src/public/ ./dist/ && cp -r ./src/frontend/views/ ./dist/frontend/ && cp -r ./src/backend/templates/ ./dist/backend/",
        "copy-env": "cp .env ./dist/",
        "dev": "nodemon --exec node --loader ts-node/esm src/index.ts",
        "migrate:up": "npx sequelize-cli db:migrate",
        "migrate:undo": "npx sequelize-cli db:migrate:undo",
        "seed:up": "npx sequelize-cli db:seed:all"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/dompurify": "^3.0.5",
        "@types/express": "^4.17.17",
        "@types/express-mysql-session": "^3.0.0",
        "@types/express-session": "^1.17.7",
        "@types/nodemailer": "^6.4.11",
        "@types/styled-components": "^5.1.29",
        "sequelize-cli": "6.6.1",
        "ts-node": "^10.9.1",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@adminjs/design-system": "^4.0.3",
