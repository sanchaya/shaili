    "@types/sequelize": "^4.28.15",
    "adminjs": "^7.2.1",
    "argon2": "^0.31.1",
    "connect-mysql-session": "^0.1.3",
    "dotenv": "^16.3.1",
    "edge.js": "6.0.0-10",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "express-mysql-session": "^3.0.0",
    "express-session": "^1.17.3",
    "mysql2": "^3.6.1",
    "nodemailer": "^6.9.6",
