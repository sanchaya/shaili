<!DOCTYPE html>
<html class="h-100 w-100">
  <head>
    <title>Forgot Password | Type Extract</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
      body {
        background-color: #F8F9F9
      }

      #forgot-password-inner {
        height: 440px;
        width: auto;
        box-shadow: rgba(137, 138, 154, 0.15) 0px 15px 24px 0px;
      }

      #forgot-password-left {
        background-color: #3040D6;
        width: 380px;
        padding: 48px;
      }

      #forgot-password-left h1 {
        font-family: Roboto, sans-serif;
        padding: 0px;
        font-weight: 300;
        font-size: 32px;
        line-height: 40px;
        margin-bottom: 32px;
      }

      #forgot-password-left p {
        font-family: Roboto, sans-serif;
        font-size: 14px;
        line-height: 24px;
        font-weight: 300;
      }

      #forgot-password-right {
        width: 480px;
        padding: 48px;
        background-color: #fff;
        text-align: center;
      }

      #forgot-password-right h5 {
        font-family: Roboto, sans-serif;
        vertical-align: middle;
        padding: 0px;
        font-size: 18px;
        line-height: 24px;
        font-weight: 400;
        margin-bottom: 32px;
      }

      #forgot-password-right label {
        display: block;
        font-family: Roboto, sans-serif;
        font-size: 12px;
        line-height: 16px;
        margin-bottom: 8px;
      }

      #forgot-password-right input {
        box-sizing: border-box;
        color: rgb(12, 30, 41);
        background: transparent;
        border: 1px solid rgb(187, 195, 203);
        border-radius: 2px;
        font-size: 14px;
        line-height: 24px;
        font-family: Roboto, sans-serif;
        outline: none;
        padding: 4px 8px;
      }

      #forgot-password-right input:focus {
        border-color: rgb(48, 64, 214);
        box-shadow: none;
      }

      #forgot-password-right button {
        appearance: none;
        display: inline-block;
        background-color: transparent;
        outline: 0px;
        font-family: Roboto, sans-serif;
        font-size: 14px;
        vertical-align: middle;
        border-radius: 4px;
        user-select: none;
        text-align: center;
        border: 1px solid currentcolor;
        cursor: pointer;
        text-decoration: none;
        box-sizing: border-box;
        transition: all 0.1s ease-in 0s;
        color: rgb(48, 64, 214);
        padding: 4px 32px;
        line-height: 24px;
        margin-top: 24px;
      }

      #forgot-password-right button:hover {
        background-color: rgba(48, 64, 214, 0.05);
      }

      #forgot-password-right button:focus {
        box-shadow: none;
      }

      .message {
        font-size: 14px;
      }

      .back-to-login {
        font-family: Roboto, sans-serif;
        font-size: 14px;
        line-height: 24px;
        font-weight: 300;
        text-align: center;
        margin-top: 16px;
      }

      .back-to-login a {
        color: #551a8b;
      }
    </style>
  </head>
  <body class="h-100 w-100">
    <div class="h-100 w-100 d-flex justify-content-center align-items-center">
      <div class="d-flex" id="forgot-password-inner">
        <div class="text-white d-flex flex-column justify-content-start align-items-center" id="forgot-password-left">
          <div class="text-start w-100">
            <h1>Forgot Password</h1>
            <p>No worries. We'll send you reset instructions.</p>
          </div>
        </div>
        <form method="post" class="forgot-password-form" id="forgot-password-right" name="forgot-password-right">
          <h5 class="text-start">Type Extract</h5>
          <div class="alert message d-none text-start p-2" role="alert"></div>
          <div class="mb-3 text-start">
            <label class="form-label">* Email</label>
            <input type="email" name="forgot-password-email" id="emailInput" class="form-control" required="" placeholder="Email">
          </div>
          <button type="submit" class="btn btn-primary">Send Link</button>
          <div class="back-to-login">
            <a href="/admin/login">Back to login</a>
          </div>
        </form>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
      jQuery('#forgot-password-right').on('submit', function(e) {
        e.preventDefault();
        var email = jQuery('#emailInput').val();
        const data = {
          "email": email
        }
        jQuery.ajax({
          type: "POST",
          url: "http://localhost:8000/admin/forgot-password",
          dataType: "json",
          contentType: "application/json",
          data: JSON.stringify(data),
          success: function(response) {
            jQuery('#emailInput').val('');
            showMessage(response.message, true)
          },
          error: function(response) {
            showMessage(response.responseJSON.message, false)
          }
        });
      });

      function showMessage(message, messageType) {
        if (messageType === true) {
          jQuery('.message').removeClass('alert-danger d-none').addClass('alert-success d-block').text(message).delay(3000).fadeOut('slow', function() {
            jQuery(this).addClass('d-none').text('');
          });
        } else {
          jQuery('.message').removeClass('alert-success d-none').addClass('alert-danger d-block').text(message).delay(3000).fadeOut('slow', function() {
            jQuery(this).addClass('d-none').text('');
          });
          jQuery('#emailInput').trigger('focus');
        }
      }
    </script>
  </body>
</html>