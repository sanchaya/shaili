<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ಶೈಲಿ ಸಂಚಯ - ಕನ್ನಡದ ಐತಿಹಾಸಿಕ ಮುದ್ರಣ ಅಕ್ಷರಶೈಲಿಗಳು | Shaili Sanchaya</title>
  <meta name="description" content="Shaili Sanchaya (ಶೈಲಿ ಸಂಚಯ) - an open archive of letter styles and type specimens extracted from early Kannada printed books.">
  <link rel="icon" type="image/png" href="/images/type_extract_favicon.jpeg">
  <link rel="apple-touch-icon" href="/images/type_extract_favicon.jpeg">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/home.css">
</head>

<body>
  <div class="slide-menu-baner" id="slide-menu-baner">
    <div class="slide-menu" id="slide-menu">
      <div class="header">
        <span class="menu-brand">ಶೈಲಿ ಸಂಚಯ</span>
        <i class="fa fa-times fa-2x close-btn" id="slide-menu-close" aria-hidden="true"></i>
      </div>
      <ul class="slide-menu-item">
        <li class="active"><a href="/">ಮುಖಪುಟ</a></li>
        <li><a href="/admin">ಸಂಗ್ರಹ ನಿರ್ವಹಣೆ</a></li>
        <li><a href="#about">ಯೋಜನೆಯ ಬಗ್ಗೆ</a></li>
        <li><a href="#letter-samples">ಅಕ್ಷರಶೈಲಿಗಳು</a></li>
        <li><a href="#books">ಪುಸ್ತಕಗಳು</a></li>
        <li><a href="https://sanchaya.org" target="_blank">ಸಂಚಯ</a></li>
        <li><a href="https://sanchifoundation.org" target="_blank">ಸಂಚಿ ಫೌಂಡೇಶನ್</a></li>
        <li><a href="https://fonts.sanchaya.net" target="_blank">ಫಾಂಟ್ಸ್ ಸಂಚಯ</a></li>
      </ul>
    </div>
    <div class="gap-filler" data-close-menu></div>
  </div>

  <nav>
    <div class="center-nav">
      <a href="/"><img src="/images/type_extract_logo.jpeg" alt="ಶೈಲಿ ಸಂಚಯ" class="nav-logo"></a>
      <div class="nav-tagline">ಶೈಲಿ ಸಂಚಯ - ಕನ್ನಡದ ಅಚ್ಚು ಅಕ್ಷರಶೈಲಿಗಳಿಗೊಂದು ಸಂಚಯ</div>
    </div>
    <div class="menu-items">
      <a href="/" class="active">ಮುಖಪುಟ</a>
      <a href="/admin">ಸಂಗ್ರಹ ನಿರ್ವಹಣೆ</a>
      <div class="dropdown">
        <a class="dropbtn">ಸಂಚಯ <i class="fas fa-caret-down"></i></a>
        <div class="dropdown-content">
          <a href="https://sanchaya.org" target="_blank">ಸಂಚಯ</a>
          <a href="https://sanchifoundation.org" target="_blank">ಸಂಚಿ ಫೌಂಡೇಶನ್</a>
          <a href="https://fonts.sanchaya.net" target="_blank">ಫಾಂಟ್ಸ್ ಸಂಚಯ</a>
          <a href="https://typetest.sanchaya.net" target="_blank">TypeTest</a>
          <a href="https://converter.sanchaya.net" target="_blank">ಅಕ್ಷರರೂಪ ಪರಿವರ್ತಕ</a>
        </div>
      </div>
    </div>
    <div class="right-nav">
      <i class="fa fa-bars fa-lg hamburger-icon" id="hamburger-icon" aria-hidden="true"></i>
    </div>
  </nav>

  <header class="hero">
    <div class="hero-glyphs" aria-hidden="true">
      <span class="g-1">ಅ</span>
      <span class="g-2">ಕ</span>
      <span class="g-3">ಭ</span>
      <span class="g-4">ಶ</span>
      <span class="g-5">ೞ</span>
      <span class="g-6">ಪ</span>
      <span class="g-7">ಮ</span>
      <span class="g-8">ವ</span>
      <span class="g-9">೧</span>
      <span class="g-10">ಘ</span>
      <span class="g-11">ಲ</span>
      <span class="g-12">ಸ</span>
    </div>
    <div class="hero-inner">
      <h1 class="hero-title">ಶೈಲಿ ಸಂಚಯ</h1>
      <p class="hero-kn">ಕನ್ನಡದ ಐತಿಹಾಸಿಕ ಮುದ್ರಣ ಅಕ್ಷರಶೈಲಿಗಳ ಸಂಚಯ</p>
      <p class="hero-en">A living archive of letter styles - <em>šailis</em> - extracted specimen-by-specimen from early
        Kannada printed books.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/admin"><i class="fas fa-book-open"></i> Explore the collection</a>
        <a class="btn btn-ghost" href="#about"><i class="fas fa-info-circle"></i> ಯೋಜನೆಯ ಬಗ್ಗೆ</a>
      </div>
    </div>
  </header>

  <div class="stats-strip">
    <div class="stat-card reveal">
      <i class="fas fa-book stat-icon"></i>
      <div class="stat-value" data-count="{{ stats.books }}">{{ stats.books.toLocaleString() }}</div>
      <div class="stat-label">Books digitized</div>
      <div class="stat-kn">ಪುಸ್ತಕಗಳು</div>
    </div>
    <div class="stat-card reveal">
      <i class="fas fa-font stat-icon"></i>
      <div class="stat-value" data-count="{{ stats.letters }}">{{ stats.letters.toLocaleString() }}</div>
      <div class="stat-label">Letter specimens</div>
      <div class="stat-kn">ಅಕ್ಷರ ಮಾದರಿಗಳು</div>
    </div>
    <div class="stat-card reveal">
      <i class="fas fa-layer-group stat-icon"></i>
      <div class="stat-value" data-count="{{ stats.letterTypes }}">{{ stats.letterTypes }}</div>
      <div class="stat-label">Letter styles</div>
      <div class="stat-kn">ಅಕ್ಷರಶೈಲಿಗಳು</div>
    </div>
    <div class="stat-card reveal">
      <i class="fas fa-tags stat-icon"></i>
      <div class="stat-value" data-count="{{ stats.tagged }}">{{ stats.tagged.toLocaleString() }}</div>
      <div class="stat-label">Tagged specimens</div>
      <div class="stat-kn">ಗುರುತಿಸಿದ ಅಕ್ಷರಗಳು</div>
    </div>
    <div class="stat-card reveal">
      <i class="fas fa-language stat-icon"></i>
      <div class="stat-value" data-count="{{ stats.languages }}">{{ stats.languages }}</div>
      <div class="stat-label">Languages</div>
      <div class="stat-kn">ಭಾಷೆಗಳು</div>
    </div>
  </div>

  <main id="content">
    <section class="section container" id="letter-samples">
      <div class="section-head">
        <h2>ಅಕ್ಷರಶೈಲಿಗಳು <span>/ Letter styles</span></h2>
        <p>Every specimen in the archive is organised by the kind of letter it is - vowels, consonants, conjuncts,
          compounds, numerals and symbols - exactly as they were cut and cast for the printing press.</p>
      </div>
      <div class="type-grid">
        @each(lt in letterTypes)
          <div class="type-card reveal">
            <div class="type-card-top">
              <span class="type-badge">{{ lt.languageName }}</span>
              <span class="type-count"><i class="fas fa-asterisk"></i> {{ lt.count }} specimens</span>
            </div>
            <h3 class="type-name">{{ lt.type }}</h3>
            <div class="glyph-sample" lang="kn">{{ lt.letters.join('') }}</div>
          </div>
        @end
      </div>
      <div class="type-pagination" id="type-pagination" style="display:none;">
        <button class="pagination-btn" id="type-prev"><i class="fas fa-chevron-left"></i> Previous</button>
        <span class="pagination-info" id="type-page-info"></span>
        <button class="pagination-btn" id="type-next">Next <i class="fas fa-chevron-right"></i></button>
      </div>
    </section>

    <section class="section about-section" id="about">
      <div class="container">
        <div class="about-grid">
          <div class="about-copy">
            <h2>ಯೋಜನೆಯ ಬಗ್ಗೆ <span>/ About the project</span></h2>
            <p><strong>ಶೈಲಿ ಸಂಚಯ (Shaili Sanchaya)</strong> is an open, community-driven archive of Kannada printing
              letter styles. A <em>śaili</em> (ಶೈಲಿ) is the characteristic shape a letter takes in a particular
              typeface - the trace left behind by a foundry, a press, and an era.</p>
            <p>Working from digitised books - many printed in the 19th century by the mission presses of Mangaluru and
              Bengaluru - volunteers select individual letter specimens straight from the scanned pages, tag them by
              letter type, and assemble a reference collection that no single foundry catalogue can offer.</p>
            <ul class="about-points">
              <li><i class="fas fa-check-circle"></i> <span>Specimens sourced directly from
                  <strong>{{ stats.books }} digitized books</strong></span></li>
              <li><i class="fas fa-check-circle"></i> <span><strong>{{ stats.letters }} letter specimens</strong>
                  classified across {{ stats.letterTypes }} letter styles</span></li>
              <li><i class="fas fa-check-circle"></i> <span>Community tagged and reviewed, in Kannada
                  <em>and</em> English</span></li>
              <li><i class="fas fa-check-circle"></i> <span>Built free and open-source under the Sanchaya umbrella</span>
              </li>
            </ul>
            <div class="about-expansion">
              <i class="fas fa-globe"></i>
              <p>The archive began with <strong>Kannada</strong> - its first specimens were cut from the 19th-century
                mission presses of Mangaluru and Bengaluru. But the <em>śaili</em> method is language-agnostic: the same
                specimen-by-specimen workflow can be expanded to build <strong>revival fonts for other Indian
                  languages</strong> - Tamil, Telugu, Bengali, Marathi and more - preserving their historical printing
                styles too.</p>
            </div>
            <div class="about-cta">
              <a class="btn btn-primary" href="/admin"><i class="fas fa-arrow-right"></i> Enter the workshop</a>
              <a class="btn btn-ghost" href="#how"><i class="fas fa-arrow-down"></i> How it works</a>
            </div>
          </div>
          <div class="about-card reveal">
            <h4>ಇಂದು ಸಂಚಯದಲ್ಲಿ</h4>
            <div class="about-card-stats">
              <div><span class="big">{{ stats.letters.toLocaleString() }}</span><span class="sm">ಅಕ್ಷರ ಮಾದರಿಗಳು</span></div>
              <div><span class="big">{{ stats.tagged.toLocaleString() }}</span><span class="sm">ಗುರುತಿಸಿದ ಅಕ್ಷರಗಳು</span></div>
              <div><span class="big">{{ stats.books }}</span><span class="sm">ಪುಸ್ತಕಗಳು</span></div>
              <div><span class="big">{{ stats.languages }}</span><span class="sm">ಭಾಷೆಗಳು</span></div>
            </div>
            <p class="about-card-note">
              @if(oldestYear)
                The oldest book in the archive was printed in <strong>{{ oldestYear }} CE</strong> - browsing the
                collection takes you back to the very beginnings of Kannada printing.
              @end
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section container" id="how">
      <div class="section-head">
        <h2>ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ <span>/ How it works</span></h2>
        <p>From a page of a hundred-year-old book to a classified specimen in the archive - in three simple steps.</p>
      </div>
      <div class="steps">
        <div class="step reveal">
          <div class="step-num">1</div>
          <i class="fas fa-book-open step-icon"></i>
          <h4>ಜಾಲಾಡಿ / Browse</h4>
          <p>Open a digitized book and page through scans of early Kannada printing.</p>
        </div>
        <div class="step reveal">
          <div class="step-num">2</div>
          <i class="fas fa-crop-alt step-icon"></i>
          <h4>ಹೊರತೆಗೆಯಿರಿ / Extract</h4>
          <p>Select an individual letter specimen - a vowel, consonant or conjunct - directly from the page.</p>
        </div>
        <div class="step reveal">
          <div class="step-num">3</div>
          <i class="fas fa-tags step-icon"></i>
          <h4>ಗುರುತಿಸಿ / Tag</h4>
          <p>Classify the specimen by letter style to grow the archive for everyone.</p>
        </div>
      </div>
    </section>

    <section class="section container" id="books">
      <div class="section-head">
        <h2>ಪುಸ್ತಕಗಳು <span>/ Featured books</span></h2>
        <p>The seeds of the archive - early Kannada imprints, arranged by their year of publication.</p>
      </div>
      <div class="book-list">
        @each(book in featuredBooks)
          <a class="book-item reveal" href="/admin">
            <div class="book-year">{{ book.published_year }}</div>
            <div class="book-meta">
              <div class="book-name">{{ book.name }}</div>
              <div class="book-sub">
                @if(book.publisher_name && book.publisher_name != 'NA' && book.publisher_name != 'NULL')
                  {{ book.publisher_name }}
                @else
                  Publisher unknown
                @end
                <span class="book-dot">•</span> {{ book.languageName }}
              </div>
            </div>
            <i class="fas fa-chevron-right book-arrow"></i>
          </a>
        @end
      </div>
    </section>

    <section class="section contribute-section" id="contribute">
      <div class="container">
        <div class="contribute-card">
          <div class="contribute-content">
            <h2>Contribute to Type Extract</h2>
            <p>Type Extract is an open-source project. We welcome contributions of all kinds - bug fixes, new features, documentation, and more.</p>
            <div class="contribute-points">
              <div class="contribute-point">
                <i class="fas fa-code"></i>
                <span>Fix bugs or add features</span>
              </div>
              <div class="contribute-point">
                <i class="fas fa-book"></i>
                <span>Improve documentation</span>
              </div>
              <div class="contribute-point">
                <i class="fas fa-language"></i>
                <span>Add support for new languages</span>
              </div>
              <div class="contribute-point">
                <i class="fas fa-lightbulb"></i>
                <span>Suggest new ideas</span>
              </div>
            </div>
            <div class="contribute-actions">
              <a class="btn btn-primary" href="https://github.com/ravenanhq/type-extract" target="_blank" rel="noopener noreferrer">
                <svg height="18" width="18" viewBox="0 0 16 16" fill="white" style="margin-right: 8px; vertical-align: middle;">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                View on GitHub
              </a>
              <a class="btn btn-ghost" href="https://github.com/ravenanhq/type-extract/issues" target="_blank" rel="noopener noreferrer">
                <i class="fas fa-bug"></i> Report an Issue
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-content">
      <div class="footer-brand">
        <img src="/images/sanchaya-logo.png" alt="Sanchaya" class="footer-logo">
        <span>ಶೈಲಿ ಸಂಚಯ · ಒಂದು ಸಂಚಯ ಯೋಜನೆ</span>
      </div>
      <div class="footer-links">
        <a href="/">ಮುಖಪುಟ</a>
        <a href="/admin">ಸಂಗ್ರಹ ನಿರ್ವಹಣೆ</a>
        <a href="https://sanchaya.org" target="_blank">ಸಂಚಯ</a>
        <a href="https://sanchifoundation.org" target="_blank">ಸಂಚಿ ಫೌಂಡೇಶನ್</a>
        <a href="https://fonts.sanchaya.net" target="_blank">ಫಾಂಟ್ಸ್ ಸಂಚಯ</a>
      </div>
      <div class="footer-copyright">
        &copy; 2026 ಶೈಲಿ ಸಂಚಯ, ಸಂಚಯ ಮತ್ತು ಸಂಚಿ ಫೌಂಡೇಶನ್
      </div>
    </div>
  </footer>

  <script src="/config.js"></script>
  <script src="/js/home.js"></script>
</body>

</html>